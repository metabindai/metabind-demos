{
  "$id": "metabind-project.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Generated by `metabind pull`. Enum values reflect this project at pull time; re-pull after adding a component or secret.",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "settings": {
      "additionalProperties": true,
      "properties": {
        "cdnDomain": {
          "type": "string"
        },
        "dataTools": {
          "type": "object"
        },
        "defaultLocale": {
          "type": "string"
        },
        "defaultPlatform": {
          "type": "string"
        },
        "mcp": {
          "type": "object"
        },
        "supportedLocales": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "supportedPlatforms": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "thumbnailUrl": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "sync": {
      "additionalProperties": false,
      "description": "Which entity classes push may write. Omitted means the default partition.",
      "properties": {
        "push": {
          "items": {
            "enum": [
              "components",
              "tools",
              "settings",
              "collections",
              "content",
              "assets"
            ],
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "type": {
      "enum": [
        "content",
        "mcp"
      ],
      "type": "string"
    }
  },
  "title": "Metabind project settings",
  "type": "object"
}
